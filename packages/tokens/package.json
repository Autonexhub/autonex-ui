{
  "name": "@autonexhub/tokens",
  "version": "0.1.0",
  "description": "Design tokens for Autonex applications",
  "main": "./dist/index.css",
  "types": "./dist/tailwind.preset.d.ts",
  "exports": {
    ".": "./dist/index.css",
    "./tailwind.preset": {
      "types": "./dist/tailwind.preset.d.ts",
      "import": "./dist/tailwind.preset.mjs",
      "require": "./dist/tailwind.preset.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && cp src/index.css dist/index.css",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": {
    "tailwindcss": "^3.4.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Autonexhub/autonex-ui.git",
    "directory": "packages/tokens"
  },
  "license": "MIT"
}
